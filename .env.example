# AlpacaTradeBot — SML2 configuration. Copy to .env and fill in the blank keys.
#
# One entry per setting, holding the value SML2 actually runs with. Built
# 2026-10-18 from the live Pi .env plus the code defaults the old .env never
# set, and checked against the Pi's Oct 11 startup banner.
# Settings marked (default) match the code's built-in default; they're listed
# so the whole config is in one place.
#
# Values go on their own line — an empty value followed by "# comment" makes
# dotenv read the comment as the value.

# ── Account ──────────────────────────────────────────────────────────────────
ALPACA_PAPER=true
SML2_ALPACA_API_KEY=
SML2_ALPACA_API_SECRET=
DISCORD_WEBHOOK_URL=
# Wallet / DB id; positions are stored as <id>_SCREENER   (default)
SCREENER_ID=SML2
# Only used the first time the wallet is created          (default)
STARTING_BALANCE=500

# ── Position sizing ──────────────────────────────────────────────────────────
MAX_POSITIONS=2
# % of the account held back, never traded                (default)
RESERVE_PCT=25
# Buy a partial second slot if at least this % of a slot is left (default)
MIN_BUY_PCT_OF_SLOT=50
# Seconds before the same symbol can be bought again (86400 = once a day)
BUY_COOLDOWN_SECONDS=86400

# ── Schedule (ET) ────────────────────────────────────────────────────────────
START_TIME_ET=09:45
STOP_BUY_TIME_ET=11:45
# Sell anything still open at this time
DUMP_TIME_ET=15:30
# Skip a buy if fewer than this many minutes remain before DUMP_TIME_ET (0 = off) (default)
MIN_MINUTES_TO_DUMP=0
SCAN_INTERVAL_SECONDS=60
# How often open positions are checked                    (default)
MONITOR_INTERVAL_SECONDS=10
# Live price older than this is refreshed from a snapshot  (default)
PRICE_STALENESS_SECONDS=45

# ── Entry filters ────────────────────────────────────────────────────────────
RSI_ENTRY_MIN=60
RSI_ENTRY_MAX=70
# MACD must have been above signal for at least this many 15-min bars (default)
MACD_MIN_BARS_ABOVE_SIGNAL=3
# Time-adjusted relative volume band
MIN_RVOL=1.5
MAX_RVOL=4
# Minimum % up on the day
MIN_CHANGE_PCT=2.0
# Skip if already up more than this % on the day (0 = off)
MAX_ENTRY_MOVE_PCT=17
# Tighter "don't chase" ceiling (0 = off; backtested net-negative on its own)
SML2_DONT_CHASE_PCT=0
# Skip if ATR is above this (0 = off)                      (default)
MAX_ATR=0
# Never buy these (leveraged/decay ETPs and chronic losers)
EXCLUDE_SYMBOLS=MSTU,TZA,HTZ,ZCMD

# ── Stops ────────────────────────────────────────────────────────────────────
# HARD_STOP_PCT does two jobs (0 would turn both off and use a TRAILING_STOP_PERCENT trail instead):
#  - risk budget: each position is sized so hitting its stop loses about
#    slot x HARD_STOP_PCT, i.e. a tighter stop means more shares
#  - the flat stop % when ATR isn't available, and for re-placing a missing stop
HARD_STOP_PCT=5
# Normal resting stop = ATR_STOP_MULT x ATR, clamped to ATR_MIN..ATR_MAX %  (defaults)
ATR_STOP_MULT=2.0
ATR_MIN_STOP_PCT=2.0
ATR_MAX_STOP_PCT=10.0
# Only a last resort while HARD_STOP_PCT > 0: used if the hard stop for a
# position the bot finds on Alpaca without a stop can't be placed
TRAILING_STOP_PERCENT=10
# Profit lock: once a position is up PROFIT_LOCK_PCT, its stop becomes a TIGHT_STOP_PCT trailing stop
PROFIT_LOCK_PCT=15
TIGHT_STOP_PCT=5
# ATR trail (0 = off; turned off 2026-09-23 — it was the biggest drag in the corrected backtest)
SML2_ATR_TRAIL_ACTIVATE_PCT=0
SML2_ATR_TRAIL_MULT=1.5

# ── Exits ────────────────────────────────────────────────────────────────────
# Sell when RSI is above this and falling...
RSI_EXIT_LEVEL=75
# ...but only once the position is up at least this %   (0 = any gain)
SML2_RSI_EXIT_MIN_GAIN_PCT=5
# Checkpoints: sell if gain is below these % at 30 / 60 minutes
MIN_GAIN_AT_30M=-5
MIN_GAIN_AT_60M=-3
MAX_HOLD_MINUTES=180
# VWAP-reclaim exit: sell after this many closes below VWAP (0 = off), ignoring the first N minutes (defaults)
VWAP_RECLAIM_DWELL_MIN=9
VWAP_RECLAIM_WARMUP_MIN=3
