# Copy to .env and fill in the blanks. SML2 is the only screener.
# ── Alpaca API — Paper Trading Keys ─────────────────────────────────────────
# Paper trading keys: https://app.alpaca.markets  →  Paper  →  API Keys
ALPACA_PAPER=true

# SML2 (run_sml2_screener.py)
SML2_ALPACA_API_KEY=
SML2_ALPACA_API_SECRET=

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
TRAILING_STOP_PERCENT=10
HARD_STOP_PCT=5
MAX_ENTRY_MOVE_PCT=10
PROFIT_LOCK_PCT=15
MAX_HOLD_MINUTES=90
MAX_POSITIONS=2                # SML + MID both read this; cap both at 2
SCAN_INTERVAL_SECONDS=60       # how often to scan (seconds)
BUY_COOLDOWN_SECONDS=86400     # min time between buys per stock (86400 = once/day)
TIGHT_STOP_PCT=5               # tighter stop % applied after profit lock (default: 5)
RSI_EXIT_LEVEL=75              # sell immediately if RSI exceeds this and is falling (default: 75)
START_TIME_ET=09:45            # don't scan or buy before this time ET (raised from 09:30 on 2026-07-30 — the 9:30-9:59 window accounted for 52% of SML's and >100% of SML2's total losses)
STOP_BUY_TIME_ET=11:45         # stop opening new positions after this time ET
DUMP_TIME_ET=12:00             # force-sell all open positions at this time ET
MIN_RVOL=1.5                   # skip entry if time-adjusted RVOL < this (0 = off)
MAX_RVOL=10                    # skip entry if time-adjusted RVOL > this (0 = off) — added 2026-08-04: entry-stat history shows win rate falls from 34% at <0.5x RVOL to 8% at >10x, so extreme RVOL reads as exhaustion, not confirmation
MIN_CHANGE_PCT=2.0             # skip entry if daily gain % < this (0 = off)

# never buy these — leveraged/decay ETPs + chronic losers, added 2026-08-01
# (MSTU 1/7 win -$40, TZA 1/6 win -$9.50, HTZ 0/3 win -$22.90); ZCMD added
# 2026-08-17 (0/4 win -$18.69 across 08-07 and 08-14, both SML/SML2 — see todo.md).
# NOTE 2026-09-05: this key was previously "EXCLUDE_SYMBOLS=   # comment" on one
# line — dotenv parsed the whole comment AS the value, so nothing was actually
# excluded. Keep the value and any comment on separate lines.
EXCLUDE_SYMBOLS=MSTU,TZA,HTZ,ZCMD

# ── SML2 Screener (run_sml2_screener.py) — $0.50–$5.00 paper ─────────────────
# SML2 runs RSI/MACD/VWAP — it was the unfiltered control arm for SML's
# entry-filter-stack A/B test as of 2026-09-05, but as of 2026-09-15 it has
# its own independent exit-management tuning below (don't-chase ceiling,
# ATR trail, looser checkpoints, later exit clock, gain-gated RSI exit),
# so it's no longer a completely untouched control — SML still has none of
# these. (SML2 dropped HOD via commit b31c59a on 2026-08-20; SML rejoined
# the RSI/MACD signal on 2026-09-05.)
SML2_MAX_ENTRY_MOVE_PCT=17    # RESTORED 2026-09-19 after 2026-09-18 review — Sep 18 data: of 6 SML2 trades, TRUG(+55.16%)/VHUB(+20.06%)/APUS(+16.77%)/XRTX(+16.87%) all exceeded even the old 15% cap; the 4 blocked trades netted -$11.49 (3 losers incl. TRUG's spike-top -$9.24, offset by XRTX's +$9.48 win) vs RYDE/BTCT's -$3.02 that would've traded regardless. 17% (just above QCLS/PDSB's 15.8%/16.8% that justified disabling this) still lets in those two while blocking TRUG/VHUB/APUS-style chases and XRTX. Revisit if XRTX-style wins recur often at 16-18%.

# SML2 exit-management changes (2026-09-15) — the "improved (both bundled)"
# profile from the day-agnostic backtest (tools/backtest_symbols.py, 296
# scan-log symbols x 15 weekdays since the Aug 25 reset): 46/4074 entries,
# 65% win rate, +1.29% avg, ~$148 @ $250/trade sizing vs baseline's 57
# entries/47%/+0.71%/~$101. NOTE: the don't-chase ceiling alone backtested
# net negative (~$62), and exits_only (ceiling off) alone backtested BETTER
# than this bundle (~$157) — see reports/backtest_symbols_rsi_macd_*.csv.
# Bundled here anyway per explicit request; SML2_DONT_CHASE_PCT=0 reverts
# to the better-tested exits_only config without touching anything else.
SML2_DONT_CHASE_PCT=0          # TEMP DISABLED 2026-09-16, review by 2026-09-18 — was 9, but the Pi's 09-16 04:17 restart banner showed this had NEVER actually been deployed (DONT_CHASE_PCT=off live). Deploying it now for the first time at the same moment as SML2_MAX_ENTRY_MOVE_PCT=0 would silently reintroduce a tighter 9% cap and defeat that experiment (QCLS/PDSB were 15.8%/16.8%). Revert to 9 alongside MAX_ENTRY_MOVE_PCT once the review lands.
SML2_ATR_TRAIL_ACTIVATE_PCT=0  # OFF 2026-09-23 (was 2.5): corrected backtest showed the 1.5xATR trail was the biggest drag (-$35 -> +$47 with it off, both halves improved); falls back to +15% profit-lock -> 5% trail
SML2_ATR_TRAIL_MULT=1.5          # trail distance = 1.5x (ATR / entry_price)
SML2_MAX_RVOL=4                # added 2026-09-23 (SML2 previously used shared MAX_RVOL=10): corrected-backtest optimizer, with trail off: 10x +$47 -> 4x +$96, both halves improved; matches SML_MAX_RVOL so the A/B now tests SML's OTHER filters
SML2_RSI_EXIT_MIN_GAIN_PCT=5     # RSI-overbought exit only fires if gain >= 5% (was: fired regardless of gain)
SML2_MIN_GAIN_AT_30M=-5          # 30-min checkpoint: was -2
SML2_MIN_GAIN_AT_60M=-3          # 60-min checkpoint: was 0
SML2_MAX_HOLD_MINUTES=180        # was 90 (shared MAX_HOLD_MINUTES)
SML2_DUMP_TIME_ET=15:30          # was 12:00 (shared DUMP_TIME_ET)
