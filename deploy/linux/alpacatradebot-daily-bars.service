[Unit]
Description=AlpacaTradeBot — save full-day 1-min bars for the day's traded/tracked symbols
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=defectuous
WorkingDirectory=/home/defectuous/AlpacaTradeBot
# The bot writes its sml2.log.* files to the working directory, hence --dir .
ExecStart=/home/defectuous/AlpacaTradeBot/.venv/bin/python tools/store_daily_bars.py --dir . --db market_data.db
StandardOutput=journal
StandardError=journal
